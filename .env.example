# Copy this file to .env and fill in real values before running the server.
# Never commit the real .env file.

# Your Supabase Postgres connection string (Project Settings -> Database ->
# Connection string -> "URI", with your real password substituted in).
#
# Start with the DIRECT connection (port 5432, below) to run db:migrate
# and db:seed-admin the first time. Once that's done, switch this to the
# "Transaction" pooler connection instead (port 6543, with
# ?pgbouncer=true on the end — Supabase's dashboard shows you the exact
# string) before running the server day to day with `npm start`. See
# README.md for the full one-time setup steps.
DATABASE_URL="postgresql://postgres:YOUR-PASSWORD@YOUR-PROJECT.supabase.co:5432/postgres"

# A long random string — used to sign the admin session cookie. Generate
# one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-real-random-secret"

# The admin login. Change these before going live — anyone who knows the
# defaults can log into your dashboard.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-password"

# A second, SEPARATE long random string — signs the mobile app's customer
# and technician login tokens (issued at /api/customers/register and
# /api/technicians/by-phone). Keep this different from SESSION_SECRET so
# the two kinds of session can't be mixed up. Generate the same way:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_TOKEN_SECRET="replace-with-a-different-real-random-secret"

# From your Razorpay dashboard (Settings -> API Keys). Use the TEST keys
# while developing — they start with rzp_test_. Needed for both
# /api/payments/order and /api/payments/verify.
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_key_secret"
